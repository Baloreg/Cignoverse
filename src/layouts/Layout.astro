---
interface Props {
  title?: string;
}

const { title = "Cignoverse — Hub del Club del Cigno" } = Astro.props;
---

<!doctype html>
<html lang="it" class="scroll-smooth dark h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content="L'hub ufficiale della community del Club del Cigno. Promozioni di app, interazioni e documentazione accessibile." />
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'dark';
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-sans antialiased selection:bg-cigno-blue selection:text-white transition-colors duration-300 min-h-full flex flex-col justify-between">
    <!-- Skip link per l'accessibilità -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-slate-800 focus:text-white focus:shadow-md">
      Salta al contenuto principale
    </a>

    <div>
      <!-- Header / Navbar -->
      <header class="sticky top-0 z-40 backdrop-blur-md bg-white/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800 transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
          <a href="/" class="flex items-center gap-3 group">
            <div class="p-2.5 rounded-2xl bg-cigno-blue/15 border border-cigno-blue/30 flex items-center justify-center transition-transform group-hover:scale-110 duration-300 shadow-sm">
              <img src="/assets/favicon.svg" alt="Logo Cignoverse" class="w-8 h-8 filter brightness-125 dark:brightness-200" />
            </div>
            <span class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">Cignoverse</span>
          </a>
          <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
            <a href="/" class="hover:text-cigno-blue transition-colors">Home</a>
            <a href="/progetti" class="hover:text-cigno-blue transition-colors">Progetti</a>
            <a href="/documentazione" class="hover:text-cigno-blue transition-colors">Documentazione</a>
            <a href="/casate" class="hover:text-cigno-blue transition-colors">Casate & Clan</a>
            <a href="/community" class="hover:text-cigno-blue transition-colors">Community</a>
          </nav>
          <div class="flex items-center gap-3">
            <button id="theme-toggle" aria-label="Cambia tema" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
              <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
              <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            </button>
            <a href="/accedi" id="auth-nav-btn" class="hidden sm:inline-block bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 px-4 py-2 rounded-lg font-medium text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
              Accedi
            </a>
            <a href="/casate" class="hidden sm:inline-block bg-cigno-blue text-white px-4 py-2 rounded-lg font-medium text-sm hover:opacity-90 transition-all shadow-lg shadow-cigno-blue/20">
              Smistamento
            </a>
          </div>
        </div>
      </header>

      <main id="main-content">
        <slot />
      </main>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-100 dark:bg-slate-950 text-slate-600 dark:text-slate-400 py-12 border-t border-slate-200 dark:border-slate-800/80 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-xl bg-cigno-blue/15 border border-cigno-blue/30 flex items-center justify-center">
            <img src="/assets/favicon.svg" alt="Logo Cignoverse" class="w-6 h-6 filter brightness-125 dark:brightness-200" />
          </div>
          <span class="text-slate-900 dark:text-white font-bold tracking-tight">Cignoverse Hub</span>
        </div>
        <p class="text-sm">© {new Date().getFullYear()} Club del Cigno. Tutti i diritti riservati.</p>
      </div>
    </footer>

    <script>
      import { supabase } from '../lib/supabase';

      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });

      // Check auth status for navbar button
      async function checkAuth() {
        const authBtn = document.getElementById('auth-nav-btn') as HTMLAnchorElement;
        if (!authBtn) return;
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          authBtn.textContent = 'Profilo';
          authBtn.href = '/profilo';
        } else {
          authBtn.textContent = 'Accedi';
          authBtn.href = '/accedi';
        }
      }
      checkAuth();
    </script>
  </body>
</html>
