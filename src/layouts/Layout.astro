---
interface Props {
    title?: string;
}

const { title = "Cignoverse — Hub del Club del Cigno" } = Astro.props;
---

<!doctype html>
<html lang="it" class="scroll-smooth dark h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
        <title>{title}</title>
        <meta
            name="description"
            content="L'hub ufficiale della community del Club del Cigno. Promozioni di app, interazioni e documentazione accessibile."
        />
        <script is:inline>
            const theme = localStorage.getItem("theme") || "dark";
            if (theme === "dark") {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }
        </script>
    </head>
    <body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-cigno-blue selection:text-white transition-colors duration-300 min-h-full flex flex-col justify-between relative overflow-x-hidden">
        <!-- Sfondo animato stellare -->
        <div class="fixed inset-0 -z-20 pointer-events-none overflow-hidden">
            <div
                class="absolute inset-0 bg-cover bg-center animate-space-zoom opacity-40 dark:opacity-50"
                style="background-image: url('/assets/space-bg.png');"
            ></div>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent"></div>
        </div>

        <style>
            @keyframes spaceZoom {
                0% {
                    transform: scale(1);
                }
                50% {
                    transform: scale(1.08);
                }
                100% {
                    transform: scale(1);
                }
            }
            .animate-space-zoom {
                animation: spaceZoom 25s ease-in-out infinite;
            }
        </style>
        <!-- Skip link per l'accessibilità -->
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-slate-800 focus:text-white focus:shadow-md"
        >
            Salta al contenuto principale
        </a>

        <div>
            <!-- Header / Navbar -->
            <header class="sticky top-0 z-40 backdrop-blur-md bg-white/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800 transition-colors">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3 sm:gap-5 lg:gap-6">
                        <button
                            id="mobile-menu-btn"
                            aria-label="Menu"
                            class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white lg:hidden transition-all shrink-0"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 6h16M4 12h16M4 18h16"
                                ></path>
                            </svg>
                        </button>
                        <a
                            href="/"
                            class="flex items-center gap-3 group shrink-0"
                        >
                            <img
                                src="/assets/favicon.svg"
                                alt="Logo Cignoverse"
                                class="w-9 h-9 transition-transform group-hover:scale-110 duration-300"
                            />
                            <span class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                                Cignoverse
                            </span>
                        </a>
                        <nav class="hidden lg:flex items-center gap-4 lg:gap-5 text-sm font-medium text-slate-600 dark:text-slate-300 shrink-0">
                            <a
                                href="/"
                                class="hover:text-cigno-blue transition-colors"
                            >
                                Home
                            </a>
                            <a
                                href="/progetti"
                                class="hover:text-cigno-blue transition-colors"
                            >
                                Progetti
                            </a>
                            <a
                                href="/wiki"
                                class="hover:text-cigno-blue transition-colors"
                            >
                                Wiki
                            </a>
                            <a
                                href="/mondo"
                                class="hover:text-cigno-blue transition-colors"
                            >
                                Mondo
                            </a>
                            <a
                                href="/community"
                                class="hover:text-cigno-blue transition-colors"
                            >
                                Community
                            </a>
                        </nav>
                    </div>
                    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
                        <button
                            id="theme-toggle"
                            aria-label="Cambia tema"
                            class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700 transition-all"
                        >
                            <svg
                                class="w-5 h-5 hidden dark:block"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                                ></path>
                            </svg>
                            <svg
                                class="w-5 h-5 block dark:hidden"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                                ></path>
                            </svg>
                        </button>
                        <div id="user-menu-container" class="relative hidden">
                            <button
                                id="user-menu-btn"
                                class="flex items-center justify-center w-10 h-10 rounded-full overflow-hidden border-2 border-cigno-blue focus:outline-none focus:ring-2 focus:ring-cigno-blue/50 transition-transform hover:scale-105"
                            >
                                <span
                                    id="nav-avatar-initial"
                                    class="bg-gradient-to-br from-cigno-blue to-blue-600 text-white font-bold text-sm w-full h-full flex items-center justify-center"
                                >
                                    ?
                                </span>
                                <img
                                    id="nav-avatar-img"
                                    src=""
                                    alt="Avatar"
                                    class="w-full h-full object-cover hidden"
                                />
                            </button>
                            <div
                                id="user-dropdown"
                                class="absolute right-0 mt-2 w-48 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl py-2 hidden z-50"
                            >
                                <a
                                    href="/profilo"
                                    class="block px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                                >
                                    Il mio Profilo
                                </a>
                                <a
                                    href="/impostazioni"
                                    class="block px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                                >
                                    Impostazioni
                                </a>
                                <div class="border-t border-slate-100 dark:border-slate-800 my-1"></div>
                                <button
                                    id="nav-logout-btn"
                                    class="w-full text-left px-4 py-2 text-sm text-red-500 hover:bg-red-500/10 transition-colors"
                                >
                                    Esci (Logout)
                                </button>
                            </div>
                        </div>
                        <a
                            href="/accedi"
                            id="auth-login-btn"
                            class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 px-4 py-2 rounded-lg font-medium text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-all"
                        >
                            Accedi
                        </a>
                        <a
                            href="/mondo"
                            class="hidden sm:inline-block bg-cigno-blue text-white px-4 py-2 rounded-lg font-medium text-sm hover:opacity-90 transition-all shadow-lg shadow-cigno-blue/20"
                        >
                            Smistamento & Mondo
                        </a>
                    </div>
                </div>
            </header>
            <!-- Mobile Menu Dropdown -->
            <div
                id="mobile-menu"
                class="hidden lg:hidden border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 py-4 space-y-2 shadow-lg transition-all"
            >
                <a
                    href="/"
                    class="block px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800"
                >
                    Home
                </a>
                <a
                    href="/progetti"
                    class="block px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800"
                >
                    Progetti
                </a>
                <a
                    href="/wiki"
                    class="block px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800"
                >
                    Wiki
                </a>
                <a
                    href="/mondo"
                    class="block px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800"
                >
                    Mondo
                </a>
                <a
                    href="/community"
                    class="block px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800"
                >
                    Community
                </a>
            </div>

            <main id="main-content">
                <slot />
            </main>
        </div>

        <!-- Footer -->
        <footer class="bg-slate-100 dark:bg-slate-950 text-slate-600 dark:text-slate-400 py-12 border-t border-slate-200 dark:border-slate-800/80 mt-auto">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
                    <img
                        src="/assets/favicon.svg"
                        alt="Logo Cignoverse"
                        class="w-7 h-7"
                    />
                    <span class="text-slate-900 dark:text-white font-bold tracking-tight">
                        Cignoverse Hub
                    </span>
                </div>
                <div class="flex items-center gap-6 text-sm">
                    <a
                        href="/privacy"
                        class="hover:text-cigno-blue transition-colors"
                    >
                        Informativa sulla Privacy
                    </a>
                    <a
                        href="/termini"
                        class="hover:text-cigno-blue transition-colors"
                    >
                        Termini di Servizio
                    </a>
                </div>
                <p class="text-sm">
                    © {new Date().getFullYear()} Club del Cigno. Tutti i diritti
                    riservati.
                </p>
            </div>
        </footer>

        <script>
            import { supabase } from "../lib/supabase";

            const mobileMenuBtn = document.getElementById("mobile-menu-btn");
            const mobileMenu = document.getElementById("mobile-menu");
            mobileMenuBtn?.addEventListener("click", () => {
                mobileMenu?.classList.toggle("hidden");
            });

            const btn = document.getElementById("theme-toggle");
            btn?.addEventListener("click", () => {
                if (document.documentElement.classList.contains("dark")) {
                    document.documentElement.classList.remove("dark");
                    localStorage.setItem("theme", "light");
                } else {
                    document.documentElement.classList.add("dark");
                    localStorage.setItem("theme", "dark");
                }
            });

            async function checkAuth() {
                const userMenuContainer = document.getElementById(
                    "user-menu-container",
                );
                const authLoginBtn = document.getElementById("auth-login-btn");
                const navAvatarImg = document.getElementById(
                    "nav-avatar-img",
                ) as HTMLImageElement;
                const navAvatarInitial =
                    document.getElementById("nav-avatar-initial");

                const {
                    data: { session },
                } = await supabase.auth.getSession();
                if (session) {
                    authLoginBtn?.classList.add("hidden");
                    userMenuContainer?.classList.remove("hidden");

                    const currentUser = session.user;
                    const email = currentUser.email || "";
                    const googleAvatar =
                        currentUser.user_metadata?.avatar_url || "";
                    const savedNick =
                        localStorage.getItem("cigno_username") ||
                        email.split("@")[0];
                    const savedAvatar =
                        localStorage.getItem("cigno_avatar") || googleAvatar;

                    if (savedAvatar) {
                        navAvatarImg.src = savedAvatar;
                        navAvatarImg.classList.remove("hidden");
                        navAvatarInitial?.classList.add("hidden");
                    } else {
                        navAvatarInitial.textContent = savedNick
                            .charAt(0)
                            .toUpperCase();
                    }
                } else {
                    authLoginBtn?.classList.remove("hidden");
                    userMenuContainer?.classList.add("hidden");
                }
            }
            checkAuth();

            const userMenuBtn = document.getElementById("user-menu-btn");
            const userDropdown = document.getElementById("user-dropdown");
            userMenuBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                userDropdown?.classList.toggle("hidden");
            });

            document.addEventListener("click", () => {
                userDropdown?.classList.add("hidden");
            });

            const navLogoutBtn = document.getElementById("nav-logout-btn");
            navLogoutBtn?.addEventListener("click", async () => {
                await supabase.auth.signOut();
                window.location.href = "/";
            });
        </script>
    </body>
</html>
