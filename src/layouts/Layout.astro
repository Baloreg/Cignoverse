---
interface Props {
    title?: string;
}

const { title = "Cignoverse — Hub del Club del Cigno" } = Astro.props;
---

<!doctype html>
<html lang="it" class="scroll-smooth dark h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
        <title>{title}</title>
        <meta
            name="description"
            content="L'hub ufficiale della community del Club del Cigno. Promozioni di app, interazioni e documentazione accessibile."
        />
        <script is:inline>
            const theme = localStorage.getItem("theme") || "dark";
            if (theme === "dark") {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }
        </script>
    </head>
    <body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-cigno-blue selection:text-white transition-colors duration-300 min-h-full flex flex-col justify-between relative overflow-x-hidden">
        <!-- Sfondo con immagine nitida in movimento fluido (parallasse mouse) e campo di particelle ampiamente arricchito -->
        <div class="fixed inset-0 -z-20 pointer-events-none overflow-hidden">
            <div
                id="space-bg-layer"
                class="absolute inset-[-15%] bg-cover bg-center opacity-60 dark:opacity-75 transition-transform duration-100 ease-out will-change-transform"
                style="background-image: url('/assets/space-bg.png'); image-rendering: high-quality;"
            ></div>
            <canvas
                id="space-canvas"
                class="absolute inset-0 w-full h-full opacity-80 pointer-events-none"
            ></canvas>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/30 pointer-events-none"></div>
        </div>

        <script>
            // Parallasse del mouse fluida e nitida senza provocare re-layout o glitch sui menu
            const bgLayer = document.getElementById("space-bg-layer");
            let mouseX = window.innerWidth / 2;
            let mouseY = window.innerHeight / 2;
            let currentX = 0;
            let currentY = 0;

            window.addEventListener(
                "mousemove",
                (e) => {
                    mouseX = e.clientX - window.innerWidth / 2;
                    mouseY = e.clientY - window.innerHeight / 2;
                },
                { passive: true },
            );

            function animateBackground() {
                // Inerzia morbida per un movimento di parallasse fluido ed elegante
                currentX += (mouseX * 0.04 - currentX) * 0.06;
                currentY += (mouseY * 0.04 - currentY) * 0.06;

                if (bgLayer) {
                    bgLayer.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) scale(1.08)`;
                }

                requestAnimationFrame(animateBackground);
            }
            animateBackground();

            // Canvas ad alte prestazioni con 150+ particelle stellari e flussi di luce Veyr
            const canvas = document.getElementById(
                "space-canvas",
            ) as HTMLCanvasElement;
            if (canvas) {
                const ctx = canvas.getContext("2d");
                let width = (canvas.width = window.innerWidth);
                let height = (canvas.height = window.innerHeight);

                window.addEventListener("resize", () => {
                    width = canvas.width = window.innerWidth;
                    height = canvas.height = window.innerHeight;
                });

                const particles: any[] = [];
                const numParticles = 150; // Densità particellare aumentata

                for (let i = 0; i < numParticles; i++) {
                    particles.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        radius: Math.random() * 2.2 + 0.6,
                        color:
                            Math.random() > 0.4
                                ? "rgba(56, 189, 248, "
                                : "rgba(251, 191, 36, ",
                        alpha: Math.random() * 0.8 + 0.2,
                        speedX: (Math.random() - 0.5) * 0.4,
                        speedY: (Math.random() - 0.5) * 0.4 - 0.1,
                        pulse: Math.random() * 0.02 + 0.005,
                    });
                }

                function drawParticles() {
                    ctx?.clearRect(0, 0, width, height);
                    particles.forEach((p) => {
                        p.x += p.speedX;
                        p.y += p.speedY;
                        p.alpha += Math.sin(Date.now() * p.pulse) * 0.01;

                        if (p.x < 0) p.x = width;
                        if (p.x > width) p.x = 0;
                        if (p.y < 0) p.y = height;
                        if (p.y > height) p.y = 0;

                        if (ctx) {
                            ctx.beginPath();
                            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                            ctx.fillStyle =
                                p.color +
                                Math.max(0.15, Math.min(1, p.alpha)) +
                                ")";
                            ctx.shadowBlur = 8;
                            ctx.shadowColor = p.color + "0.8)";
                            ctx.fill();
                        }
                    });
                    requestAnimationFrame(drawParticles);
                }
                drawParticles();
            }
        </script>
        <!-- Skip link per l'accessibilità -->
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-slate-800 focus:text-white focus:shadow-md"
        >
            Salta al contenuto principale
        </a>

        <div>
            <!-- Header / Navbar -->
            <header class="sticky top-0 z-40 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80 transition-colors">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3 sm:gap-5 lg:gap-6">
                        <button
                            id="mobile-menu-btn"
                            aria-label="Menu"
                            class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:text-white lg:hidden transition-all shrink-0"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 6h16M4 12h16M4 18h16"
                                ></path>
                            </svg>
                        </button>
                        <a
                            href="/"
                            class="flex items-center gap-3 group shrink-0"
                        >
                            <img
                                src="/assets/favicon.svg"
                                alt="Logo Cignoverse"
                                class="w-9 h-9 transition-transform group-hover:scale-110 duration-300"
                            />
                            <span class="text-xl font-extrabold tracking-tight text-white">
                                Cignoverse
                            </span>
                        </a>
                        <nav class="hidden lg:flex items-center gap-4 lg:gap-5 text-sm font-medium text-slate-300 shrink-0">
                            <a
                                href="/"
                                class="hover:text-cigno-blue transition-colors"
                            >
                                Home
                            </a>
                            <a
                                href="/progetti"
                                class="hover:text-cigno-blue transition-colors"
                            >
                                Progetti
                            </a>
                            <a
                                href="/wiki"
                                class="hover:text-cigno-blue transition-colors"
                            >
                                Wiki
                            </a>

                            <a
                                href="/community"
                                class="hover:text-cigno-blue transition-colors"
                            >
                                Community
                            </a>
                        </nav>
                    </div>
                    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
                        <button
                            id="theme-toggle"
                            aria-label="Cambia tema"
                            class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-all hidden"
                        ></button>
                        <div id="user-menu-container" class="relative hidden">
                            <button
                                id="user-menu-btn"
                                class="flex items-center justify-center w-10 h-10 rounded-full overflow-hidden border-2 border-cigno-blue focus:outline-none focus:ring-2 focus:ring-cigno-blue/50 transition-transform hover:scale-105"
                            >
                                <span
                                    id="nav-avatar-initial"
                                    class="bg-gradient-to-br from-cigno-blue to-blue-600 text-white font-bold text-sm w-full h-full flex items-center justify-center"
                                >
                                    ?
                                </span>
                                <img
                                    id="nav-avatar-img"
                                    src=""
                                    alt="Avatar"
                                    class="w-full h-full object-cover hidden"
                                />
                            </button>
                            <div
                                id="user-dropdown"
                                class="absolute right-0 mt-2 w-48 bg-slate-900 border border-slate-800 rounded-2xl shadow-xl py-2 hidden z-50"
                            >
                                <a
                                    href="/profilo"
                                    class="block px-4 py-2 text-sm text-slate-200 hover:bg-slate-800 transition-colors"
                                >
                                    Il mio Profilo
                                </a>
                                <a
                                    href="/impostazioni"
                                    class="block px-4 py-2 text-sm text-slate-200 hover:bg-slate-800 transition-colors"
                                >
                                    Impostazioni
                                </a>
                                <div class="border-t border-slate-800 my-1"></div>
                                <button
                                    id="nav-logout-btn"
                                    class="w-full text-left px-4 py-2 text-sm text-red-400 hover:bg-red-500/10 transition-colors"
                                >
                                    Esci (Logout)
                                </button>
                            </div>
                        </div>
                        <a
                            href="/accedi"
                            id="auth-login-btn"
                            class="inline-block bg-slate-800 text-slate-200 px-4 py-2 rounded-lg font-medium text-sm hover:bg-slate-700 transition-all"
                        >
                            Accedi
                        </a>
                        <a
                            href="/smistamento"
                            class="hidden sm:inline-block bg-cigno-blue text-white px-4 py-2 rounded-lg font-medium text-sm hover:opacity-90 transition-all shadow-lg shadow-cigno-blue/20"
                        >
                            Smistamento Casate
                        </a>
                    </div>
                </div>
            </header>
            <!-- Mobile Menu Dropdown -->
            <div
                id="mobile-menu"
                class="hidden lg:hidden border-b border-slate-800 bg-slate-950/95 backdrop-blur-md px-4 py-4 space-y-2 shadow-lg transition-all"
            >
                <a
                    href="/"
                    class="block px-3 py-2.5 rounded-xl text-sm font-medium text-slate-200 hover:bg-slate-800"
                >
                    Home
                </a>
                <a
                    href="/progetti"
                    class="block px-3 py-2.5 rounded-xl text-sm font-medium text-slate-200 hover:bg-slate-800"
                >
                    Progetti
                </a>
                <a
                    href="/wiki"
                    class="block px-3 py-2.5 rounded-xl text-sm font-medium text-slate-200 hover:bg-slate-800"
                >
                    Wiki
                </a>

                <a
                    href="/community"
                    class="block px-3 py-2.5 rounded-xl text-sm font-medium text-slate-200 hover:bg-slate-800"
                >
                    Community
                </a>
            </div>

            <main id="main-content">
                <slot />
            </main>
        </div>

        <!-- Footer -->
        <footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-800/80 mt-auto">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
                    <img
                        src="/assets/favicon.svg"
                        alt="Logo Cignoverse"
                        class="w-7 h-7"
                    />
                    <span class="text-white font-bold tracking-tight">
                        Cignoverse Hub
                    </span>
                </div>
                <div class="flex items-center gap-6 text-sm">
                    <a
                        href="/privacy"
                        class="hover:text-cigno-blue transition-colors"
                    >
                        Informativa sulla Privacy
                    </a>
                    <a
                        href="/termini"
                        class="hover:text-cigno-blue transition-colors"
                    >
                        Termini di Servizio
                    </a>
                </div>
                <p class="text-sm">
                    © {new Date().getFullYear()} Club del Cigno. Tutti i diritti
                    riservati.
                </p>
            </div>
        </footer>

        <script>
            import { supabase } from "../lib/supabase";

            const mobileMenuBtn = document.getElementById("mobile-menu-btn");
            const mobileMenu = document.getElementById("mobile-menu");
            mobileMenuBtn?.addEventListener("click", () => {
                mobileMenu?.classList.toggle("hidden");
            });

            async function checkAuth() {
                const userMenuContainer = document.getElementById(
                    "user-menu-container",
                );
                const authLoginBtn = document.getElementById("auth-login-btn");
                const navAvatarImg = document.getElementById(
                    "nav-avatar-img",
                ) as HTMLImageElement;
                const navAvatarInitial =
                    document.getElementById("nav-avatar-initial");

                const {
                    data: { session },
                } = await supabase.auth.getSession();
                if (session) {
                    authLoginBtn?.classList.add("hidden");
                    userMenuContainer?.classList.remove("hidden");

                    const currentUser = session.user;
                    const email = currentUser.email || "";
                    const googleAvatar =
                        currentUser.user_metadata?.avatar_url || "";
                    const savedNick =
                        localStorage.getItem("cigno_username") ||
                        email.split("@")[0];
                    const savedAvatar =
                        localStorage.getItem("cigno_avatar") || googleAvatar;

                    if (savedAvatar) {
                        navAvatarImg.src = savedAvatar;
                        navAvatarImg.classList.remove("hidden");
                        if (navAvatarInitial)
                            navAvatarInitial.classList.add("hidden");
                    } else {
                        if (navAvatarInitial) {
                            navAvatarInitial.textContent = savedNick
                                .charAt(0)
                                .toUpperCase();
                        }
                    }
                } else {
                    authLoginBtn?.classList.remove("hidden");
                    userMenuContainer?.classList.add("hidden");
                }
            }
            checkAuth();

            const userMenuBtn = document.getElementById("user-menu-btn");
            const userDropdown = document.getElementById("user-dropdown");
            userMenuBtn?.addEventListener("click", (e) => {
                e.stopPropagation();
                userDropdown?.classList.toggle("hidden");
            });

            document.addEventListener("click", () => {
                userDropdown?.classList.add("hidden");
            });

            const navNavbarLogoutBtn =
                document.getElementById("nav-logout-btn");
            navNavbarLogoutBtn?.addEventListener("click", async () => {
                await supabase.auth.signOut();
                window.location.href = "/";
            });
        </script>
    </body>
</html>
