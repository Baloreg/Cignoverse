---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Il Mondo — Le Cinque Corone del Cigno">
    <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <!-- Header -->
        <div class="text-center max-w-4xl mx-auto mb-16">
            <div class="inline-flex items-center gap-2 bg-cigno-blue/10 text-cigno-blue dark:bg-cigno-blue/20 dark:text-blue-400 px-3 py-1 rounded-full text-xs font-semibold mb-4">
                <span>Lore Ufficiale • Costellazione del Cigno (Cygnus)</span>
            </div>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
                Le Cinque Corone del Cigno
            </h1>
            <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
                Un universo di realismo dinastico e reliquie stellari. Il
                feudalesimo non è una scelta estetica, ma una soluzione
                logistica in un cosmo dove la Rete Veth è instabile e il Veyr
                muove l'intera civiltà.
            </p>
        </div>

        <!-- Sezione Lore & Setting -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div class="w-12 h-12 bg-blue-500/10 text-blue-500 rounded-xl flex items-center justify-center font-bold text-lg mb-4">
                    01
                </div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
                    La Stella Dominante
                </h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                    Nidificato attorno a <strong>Deneb (alpha Cygni)</strong>,
                    l'antico Impero Cygnico ha lasciato in eredità reliquie
                    galattiche e il controllo del Trono orbitale della Croce del
                    Nord.
                </p>
            </div>

            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div class="w-12 h-12 bg-amber-500/10 text-amber-500 rounded-xl flex items-center justify-center font-bold text-lg mb-4">
                    02
                </div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
                    L'Energia Veyr
                </h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                    Non magia fantasy, ma una forza fisica incanalata attraverso
                    infrastrutture avanzate, portali, motori e nodi strategici
                    che regolano il commercio e la sopravvivenza.
                </p>
            </div>

            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div class="w-12 h-12 bg-purple-500/10 text-purple-500 rounded-xl flex items-center justify-center font-bold text-lg mb-4">
                    03
                </div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
                    La Frattura
                </h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                    700 anni fa, il crollo della Rete Veth ha frammentato il
                    potere centrale. Oggi le Casate nobiliari lottano per
                    controllare i nodi e le rotte stellari.
                </p>
            </div>
        </div>

        <!-- Sezione Test / Smistamento nel Mondo -->
        <div
            id="smistamento-section"
            class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16"
        >
            <!-- Card Test Smistamento -->
            <div class="lg:col-span-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-cigno-blue/10 rounded-full blur-2xl pointer-events-none"></div>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">
                    Il Test di Smistamento tra le Casate
                </h2>
                <p class="text-slate-600 dark:text-slate-300 text-sm mb-6">
                    Rispondi alle domande e scopri a quale delle Grandi Casate
                    delle Cinque Corone appartieni per filosofia e attitudine
                    nel Cignoverse.
                </p>

                <!-- Quiz Container -->
                <div id="quiz-container">
                    <div id="quiz-intro">
                        <button
                            id="start-quiz-btn"
                            class="bg-cigno-blue text-white px-6 py-3 rounded-xl font-semibold hover:opacity-90 transition-all shadow-lg shadow-cigno-blue/20"
                        >
                            Inizia il Test di Smistamento Stellare
                        </button>
                    </div>

                    <div id="quiz-questions" class="hidden space-y-6">
                        <div class="flex justify-between text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            <span id="question-counter">Domanda 1 di 3</span>
                            <span id="quiz-progress-text">33%</span>
                        </div>
                        <h3
                            id="question-title"
                            class="text-xl font-semibold text-slate-900 dark:text-white"
                        ></h3>
                        <div
                            id="question-options"
                            class="grid grid-cols-1 gap-3"
                        ></div>
                    </div>

                    <div id="quiz-result" class="hidden text-center py-8">
                        <span class="text-xs font-semibold uppercase tracking-wider text-cigno-blue">
                            Casata Assegnata
                        </span>
                        <h3
                            id="result-house-name"
                            class="text-3xl font-extrabold text-slate-900 dark:text-white mt-2 mb-3"
                        ></h3>
                        <p
                            id="result-house-desc"
                            class="text-slate-600 dark:text-slate-300 max-w-lg mx-auto mb-6 text-sm"
                        ></p>
                        <div class="flex justify-center gap-4">
                            <button
                                id="save-house-btn"
                                class="bg-cigno-blue text-white px-6 py-3 rounded-xl font-semibold hover:opacity-90 transition-all shadow-lg shadow-cigno-blue/20"
                            >
                                Registra la tua Casata (Cloud)
                            </button>
                            <button
                                id="retake-btn"
                                class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-4 py-3 rounded-xl font-medium hover:bg-slate-200 dark:hover:bg-slate-700"
                            >
                                Ricomincia Test
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card Profilo & Casata Corrente -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
                        Il tuo Profilo nel Cignoverse
                    </h3>
                    <div
                        id="user-profile-card"
                        class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 mb-6"
                    >
                        <div class="flex items-center gap-3 mb-3">
                            <div
                                id="user-avatar"
                                class="w-10 h-10 rounded-full bg-cigno-blue/20 text-cigno-blue flex items-center justify-center font-bold"
                            >
                                ?
                            </div>
                            <div>
                                <p
                                    id="user-name-display"
                                    class="font-bold text-slate-900 dark:text-white text-sm"
                                >
                                    Ospite
                                </p>
                                <p
                                    id="user-house-display"
                                    class="text-xs text-slate-500 dark:text-slate-400"
                                >
                                    Nessuna Casata
                                </p>
                            </div>
                        </div>
                        <div
                            id="user-clan-info"
                            class="text-xs text-slate-600 dark:text-slate-300"
                        >
                            Fazione / Clan:{" "}
                            <span class="font-semibold text-slate-900 dark:text-white">
                                Nessuno
                            </span>
                        </div>
                    </div>
                </div>

                <div class="space-y-3">
                    <label
                        for="username-input"
                        class="block text-xs font-medium text-slate-700 dark:text-slate-300"
                    >
                        Il tuo Nome Stellare:
                    </label>
                    <input
                        type="text"
                        id="username-input"
                        placeholder="Es. CygnusCommander"
                        class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cigno-blue"
                    />
                    <button
                        id="update-profile-btn"
                        class="w-full bg-slate-800 dark:bg-slate-700 text-white py-2 rounded-lg font-medium text-sm hover:opacity-90 transition-opacity"
                    >
                        Aggiorna Profilo Cloud
                    </button>
                </div>
            </div>
        </div>

        <!-- Sezione Clan & Guerre tra Corone -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
            <!-- Fazioni & Clan -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
                        Fazioni & Clan Stellari
                    </h2>
                    <button
                        id="open-create-clan-modal"
                        class="text-xs bg-cigno-blue/10 text-cigno-blue dark:bg-cigno-blue/20 dark:text-blue-400 px-3 py-1.5 rounded-lg font-semibold hover:bg-cigno-blue/20"
                    >
                        Fonda Clan
                    </button>
                </div>
                <div id="clans-list" class="space-y-4">
                    <!-- Popolato via JS -->
                </div>
            </div>

            <!-- Guerre per la Croce del Nord -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">
                    Guerre per la Croce del Nord
                </h2>
                <p class="text-slate-600 dark:text-slate-300 text-sm mb-6">
                    Il controllo del Trono orbitale e dei nodi Veyr contesi.
                    Ogni contributo ai progetti della community rafforza la tua
                    fazione nella galassia.
                </p>

                <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 mb-6">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
                            Scontro orbitale attivo
                        </span>
                        <span class="text-xs text-slate-500 dark:text-slate-400">
                            Rete Veth in ricalibrazione
                        </span>
                    </div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">
                        Dominio: Nodo Veyr Deneb-Alpha vs Flotta Cygnica
                    </p>
                </div>

                <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-3">
                    Classifica dei Clan
                </h3>
                <div id="clans-leaderboard" class="space-y-3">
                    <!-- Popolato via JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Fondazione Clan -->
    <div
        id="clan-modal"
        class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4"
    >
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 max-w-md w-full shadow-2xl">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
                Fonda una nuova Casata o Clan
            </h3>
            <div class="space-y-4">
                <div>
                    <label
                        for="new-clan-name"
                        class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"
                    >
                        Nome del Clan:
                    </label>
                    <input
                        type="text"
                        id="new-clan-name"
                        placeholder="Es. Cavalieri di Deneb"
                        class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm"
                    />
                </div>
                <div>
                    <label
                        for="new-clan-tag"
                        class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"
                    >
                        Sigla Stellare (es. [DNB]):
                    </label>
                    <input
                        type="text"
                        id="new-clan-tag"
                        placeholder="[DNB]"
                        maxlength="5"
                        class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm uppercase"
                    />
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button
                        id="close-modal-btn"
                        class="px-4 py-2 rounded-lg text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800"
                    >
                        Annulla
                    </button>
                    <button
                        id="submit-clan-btn"
                        class="bg-cigno-blue text-white px-4 py-2 rounded-lg text-sm font-semibold hover:opacity-90"
                    >
                        Fonda
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        import { supabase } from "../lib/supabase";

        const houses = [
            {
                id: "veyr",
                name: "Casata Veyr",
                color: "text-amber-500",
                bg: "bg-amber-500/10",
                desc: "Custodi dell'energia e delle infrastrutture tecnologiche. Senza di loro, i motori galattici e la Rete Veth si spegnerebbero per sempre.",
            },
            {
                id: "veth",
                name: "Casata Veth",
                color: "text-blue-500",
                bg: "bg-blue-500/10",
                desc: "Navigatori dei portali instabili e delle rotte interstellari. Esperti di comunicazione quantistica e mappatura dei nodi perduti.",
            },
            {
                id: "deneb",
                name: "Casata Deneb",
                color: "text-purple-500",
                bg: "bg-purple-500/10",
                desc: "Eredi diretti dell'antico Impero Cygnico. Difendono la tradizione dinastica e ambiscono al Trono orbitale della Croce del Nord.",
            },
            {
                id: "frattura",
                name: "I Liberi della Frattura",
                color: "text-emerald-500",
                bg: "bg-emerald-500/10",
                desc: "Ribelli, hacker e pionieri che rifiutano il giogo feudale, operando ai margini della Rete per la libertà della community galattica.",
            },
        ];

        const questions = [
            {
                title: "Di fronte a un portale Veth instabile durante una missione critica, come agisci?",
                options: [
                    {
                        text: "Ricalibro i flussi di energia Veyr con precisione scientifica.",
                        house: "veyr",
                    },
                    {
                        text: "Calcolo una rotta alternativa attraverso lo spazio profondo.",
                        house: "veth",
                    },
                    {
                        text: "Rivendico il controllo del varco in nome della sovranità dinastica.",
                        house: "deneb",
                    },
                    {
                        text: "Manometto il protocollo di sicurezza per farlo funzionare per tutti i liberi.",
                        house: "frattura",
                    },
                ],
            },
            {
                title: "Quale risorsa consideri più preziosa nelle Cinque Corone?",
                options: [
                    {
                        text: "I nodi energetici stabili e i reattori a Veyr.",
                        house: "veyr",
                    },
                    {
                        text: "Le coordinate segrete della Rete di portali.",
                        house: "veth",
                    },
                    {
                        text: "Il lignaggio e le reliquie dell'Impero Cygnico.",
                        house: "deneb",
                    },
                    {
                        text: "La conoscenza aperta e condivisa tra i sistemi.",
                        house: "frattura",
                    },
                ],
            },
            {
                title: "Come contribuisci alla ricostruzione del Cignoverse?",
                options: [
                    {
                        text: "Ottimizzando l'efficienza delle app e delle piattaforme.",
                        house: "veyr",
                    },
                    {
                        text: "Mappando ogni bug e garantendo la fluidità dei collegamenti.",
                        house: "veth",
                    },
                    {
                        text: "Coordinando la community con leadership e visione strategica.",
                        house: "deneb",
                    },
                    {
                        text: "Scrivendo codice open source e creando strumenti per la community.",
                        house: "frattura",
                    },
                ],
            },
        ];

        let currentQuizIndex = 0;
        let scores = { veyr: 0, veth: 0, deneb: 0, frattura: 0 };
        let assignedHouse: any = null;
        let currentUser: any = null;
        let username = "CygnusPilot";
        let userHouse: string | null = null;
        let userClan = "Nessuno";
        let userAvatarUrl = "";

        let clans = JSON.parse(
            localStorage.getItem("cigno_clans") ||
                JSON.stringify([
                    {
                        id: 1,
                        name: "Guardiani di Deneb",
                        tag: "[DNB]",
                        points: 1540,
                        members: 9,
                    },
                    {
                        id: 2,
                        name: "Sighed Veth Navigators",
                        tag: "[VTH]",
                        points: 1280,
                        members: 7,
                    },
                    {
                        id: 3,
                        name: "Liberi della Frattura",
                        tag: "[FRT]",
                        points: 1120,
                        members: 6,
                    },
                ]),
        );

        const userNameDisplay = document.getElementById("user-name-display");
        const userHouseDisplay = document.getElementById("user-house-display");
        const userClanInfo = document.getElementById("user-clan-info");
        const usernameInput = document.getElementById(
            "username-input",
        ) as HTMLInputElement;
        const updateProfileBtn = document.getElementById("update-profile-btn");

        const startQuizBtn = document.getElementById("start-quiz-btn");
        const quizIntro = document.getElementById("quiz-intro");
        const quizQuestions = document.getElementById("quiz-questions");
        const quizResult = document.getElementById("quiz-result");
        const questionTitle = document.getElementById("question-title");
        const questionCounter = document.getElementById("question-counter");
        const quizProgressText = document.getElementById("quiz-progress-text");
        const questionOptions = document.getElementById("question-options");
        const resultHouseName = document.getElementById("result-house-name");
        const resultHouseDesc = document.getElementById("result-house-desc");
        const saveHouseBtn = document.getElementById("save-house-btn");
        const retakeBtn = document.getElementById("retake-btn");

        const clansList = document.getElementById("clans-list");
        const clansLeaderboard = document.getElementById("clans-leaderboard");
        const openCreateClanModal = document.getElementById(
            "open-create-clan-modal",
        );
        const clanModal = document.getElementById("clan-modal");
        const closeModalBtn = document.getElementById("close-modal-btn");
        const submitClanBtn = document.getElementById("submit-clan-btn");
        const newClanNameInput = document.getElementById(
            "new-clan-name",
        ) as HTMLInputElement;
        const newClanTagInput = document.getElementById(
            "new-clan-tag",
        ) as HTMLInputElement;
        const userAvatar = document.getElementById("user-avatar");

        async function initUser() {
            const {
                data: { session },
            } = await supabase.auth.getSession();
            if (session && session.user) {
                currentUser = session.user;
                const email = currentUser.email || "";
                const googleMeta = currentUser.user_metadata || {};
                username = googleMeta.full_name || email.split("@")[0];
                userAvatarUrl = googleMeta.avatar_url || "";

                const { data: profile } = await supabase
                    .from("profiles")
                    .select("*")
                    .eq("id", currentUser.id)
                    .single();

                if (profile) {
                    if (profile.username) username = profile.username;
                    if (profile.house) userHouse = profile.house;
                    if (profile.clan) userClan = profile.clan;
                    if (profile.avatar_url) userAvatarUrl = profile.avatar_url;
                } else {
                    userHouse = localStorage.getItem("cigno_house");
                    userClan = localStorage.getItem("cigno_clan") || "Nessuno";
                    await saveProfileToSupabase({
                        username,
                        house: userHouse,
                        clan: userClan,
                        avatar_url: userAvatarUrl,
                    });
                }
            } else {
                username =
                    localStorage.getItem("cigno_username") || "CygnusPilot";
                userHouse = localStorage.getItem("cigno_house") || null;
                userClan = localStorage.getItem("cigno_clan") || "Nessuno";
            }
            updateUI();
        }

        async function saveProfileToSupabase(fields: {
            username?: string;
            house?: string | null;
            clan?: string;
            avatar_url?: string;
        }) {
            if (!currentUser) {
                if (fields.username)
                    localStorage.setItem("cigno_username", fields.username);
                if (fields.house !== undefined)
                    fields.house
                        ? localStorage.setItem("cigno_house", fields.house)
                        : localStorage.removeItem("cigno_house");
                if (fields.clan)
                    localStorage.setItem("cigno_clan", fields.clan);
                return;
            }

            const updates = {
                id: currentUser.id,
                updated_at: new Date(),
                username,
                house: userHouse,
                clan: userClan,
                avatar_url: userAvatarUrl,
                ...fields,
            };

            await supabase.from("profiles").upsert(updates);
        }

        function updateUI() {
            if (userNameDisplay) userNameDisplay.textContent = username;
            if (usernameInput) usernameInput.value = username;
            if (userAvatar) {
                if (userAvatarUrl) {
                    userAvatar.innerHTML = `<img src="${userAvatarUrl}" alt="Avatar" class="w-full h-full object-cover rounded-full" />`;
                } else {
                    userAvatar.textContent = username.charAt(0).toUpperCase();
                }
            }

            if (userHouse) {
                const h = houses.find((item) => item.id === userHouse);
                if (userHouseDisplay) {
                    userHouseDisplay.textContent = h ? h.name : userHouse;
                    userHouseDisplay.className = `text-xs font-semibold ${h ? h.color : "text-slate-400"}`;
                }
            } else {
                if (userHouseDisplay) {
                    userHouseDisplay.textContent = "Nessuna Casata";
                    userHouseDisplay.className = "text-xs text-slate-400";
                }
            }

            if (userClanInfo) {
                userClanInfo.innerHTML = `Fazione / Clan: <span class="font-semibold text-slate-900 dark:text-white">${userClan}</span>`;
            }

            renderClans();
        }

        function renderClans() {
            const sorted = [...clans].sort((a, b) => b.points - a.points);

            if (clansList) {
                clansList.innerHTML = clans
                    .map(
                        (c) => `
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-cigno-blue mr-2">${c.tag}</span>
              <span class="font-bold text-slate-900 dark:text-white">${c.name}</span>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">${c.members} membri • ${c.points} punti</p>
            </div>
            <button onclick="window.joinClan('${c.name}')" class="text-xs px-3 py-1.5 rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 font-medium hover:bg-cigno-blue hover:text-white transition-colors">
              ${userClan === c.name ? "Il tuo Clan" : "Unisciti"}
            </button>
          </div>
        `,
                    )
                    .join("");
            }

            if (clansLeaderboard) {
                clansLeaderboard.innerHTML = sorted
                    .map(
                        (c, index) => `
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/40">
            <div class="flex items-center gap-3">
              <span class="font-bold text-sm text-slate-400">#${index + 1}</span>
              <div>
                <span class="font-semibold text-slate-900 dark:text-white text-sm">${c.name}</span>
                <span class="text-xs text-slate-500 ml-1">${c.tag}</span>
              </div>
            </div>
            <span class="text-sm font-bold text-cigno-blue">${c.points} pt</span>
          </div>
        `,
                    )
                    .join("");
            }
        }

        (window as any).joinClan = async function (name: string) {
            userClan = name;
            await saveProfileToSupabase({ clan: userClan });
            updateUI();
        };

        updateProfileBtn?.addEventListener("click", async () => {
            if (usernameInput.value.trim()) {
                username = usernameInput.value.trim();
                await saveProfileToSupabase({ username });
                updateUI();
                alert("Nome stellare aggiornato sul cloud!");
            }
        });

        startQuizBtn?.addEventListener("click", () => {
            quizIntro?.classList.add("hidden");
            quizQuestions?.classList.remove("hidden");
            currentQuizIndex = 0;
            scores = { veyr: 0, veth: 0, deneb: 0, frattura: 0 };
            loadQuestion();
        });

        function loadQuestion() {
            const q = questions[currentQuizIndex];
            if (questionTitle) questionTitle.textContent = q.title;
            if (questionCounter)
                questionCounter.textContent = `Domanda ${currentQuizIndex + 1} di ${questions.length}`;
            if (quizProgressText)
                quizProgressText.textContent = `${Math.round(((currentQuizIndex + 1) / questions.length) * 100)}%`;

            if (questionOptions) {
                questionOptions.innerHTML = q.options
                    .map(
                        (opt) => `
          <button data-house="${opt.house}" class="quiz-option text-left p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-medium hover:border-cigno-blue hover:bg-cigno-blue/5 transition-all">
            ${opt.text}
          </button>
        `,
                    )
                    .join("");

                document.querySelectorAll(".quiz-option").forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        const house = (
                            e.currentTarget as HTMLElement
                        ).getAttribute("data-house") as keyof typeof scores;
                        scores[house]++;
                        currentQuizIndex++;
                        if (currentQuizIndex < questions.length) {
                            loadQuestion();
                        } else {
                            finishQuiz();
                        }
                    });
                });
            }
        }

        function finishQuiz() {
            quizQuestions?.classList.add("hidden");
            quizResult?.classList.remove("hidden");

            let bestHouse = "veyr";
            let maxScore = -1;
            for (const h in scores) {
                if (scores[h as keyof typeof scores] > maxScore) {
                    maxScore = scores[h as keyof typeof scores];
                    bestHouse = h;
                }
            }

            assignedHouse = houses.find((h) => h.id === bestHouse);
            if (resultHouseName) {
                resultHouseName.textContent = assignedHouse.name;
                resultHouseName.className = `text-3xl font-extrabold mt-2 mb-3 ${assignedHouse.color}`;
            }
            if (resultHouseDesc) {
                resultHouseDesc.textContent = assignedHouse.desc;
            }
        }

        saveHouseBtn?.addEventListener("click", async () => {
            if (assignedHouse) {
                userHouse = assignedHouse.id;
                await saveProfileToSupabase({ house: userHouse });
                updateUI();
                quizResult?.classList.add("hidden");
                quizIntro?.classList.remove("hidden");
                alert(
                    `Il tuo legame con la ${assignedHouse.name} è stato registrato nel cloud.`,
                );
            }
        });

        retakeBtn?.addEventListener("click", () => {
            quizResult?.classList.add("hidden");
            quizIntro?.classList.remove("hidden");
        });

        openCreateClanModal?.addEventListener("click", () => {
            clanModal?.classList.remove("hidden");
        });
        closeModalBtn?.addEventListener("click", () => {
            clanModal?.classList.add("hidden");
        });
        submitClanBtn?.addEventListener("click", async () => {
            const name = newClanNameInput.value.trim();
            const tag = newClanTagInput.value.trim().toUpperCase();
            if (name && tag) {
                clans.push({
                    id: Date.now(),
                    name,
                    tag,
                    points: 100,
                    members: 1,
                });
                localStorage.setItem("cigno_clans", JSON.stringify(clans));
                userClan = name;
                await saveProfileToSupabase({ clan: userClan });
                newClanNameInput.value = "";
                newClanTagInput.value = "";
                clanModal?.classList.add("hidden");
                updateUI();
            }
        });

        initUser();
    </script>
</Layout>
