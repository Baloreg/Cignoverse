---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Profilo Utente — Cignoverse">
  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-2xl mx-auto">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 sm:p-10 shadow-sm">
      <!-- Header Profilo -->
      <div class="flex flex-col sm:flex-row items-center gap-6 mb-8 pb-8 border-b border-slate-200 dark:border-slate-800 text-center sm:text-left">
        <div class="relative group">
          <div id="avatar-container" class="w-24 h-24 rounded-2xl bg-gradient-to-br from-cigno-blue to-blue-600 text-white flex items-center justify-center font-extrabold text-3xl overflow-hidden shadow-lg shadow-cigno-blue/20 border-2 border-white dark:border-slate-800">
            <span id="avatar-initial">?</span>
            <img id="avatar-img" src="" alt="Avatar" class="w-full h-full object-cover hidden" />
          </div>
          <div class="absolute -bottom-2 -right-2 bg-emerald-500 w-6 h-6 rounded-full border-2 border-white dark:border-slate-900 flex items-center justify-center text-[10px] text-white font-bold" title="Online">✓</div>
        </div>
        <div>
          <h1 id="user-display-name" class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">Caricamento...</h1>
          <p id="user-email" class="text-slate-500 dark:text-slate-400 text-sm mt-0.5">...</p>
          <div class="flex flex-wrap gap-2 mt-3 justify-center sm:justify-start">
            <span id="badge-house" class="px-3 py-1 rounded-full text-xs font-semibold bg-cigno-blue/10 text-cigno-blue">Nessuna Casata</span>
            <span id="badge-clan" class="px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/10 text-purple-400">Nessun Clan</span>
          </div>
        </div>
      </div>

      <!-- Form Modifica Profilo -->
      <div class="space-y-6">
        <div>
          <label for="nickname-input" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Il tuo Nickname</label>
          <input type="text" id="nickname-input" placeholder="Es. CignuxCoder" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cigno-blue transition-all" />
        </div>

        <!-- Selettore Avatar Moderno / Preset Gallery -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-3">Scegli la tua Icona Profilo</label>
          <div class="grid grid-cols-4 sm:grid-cols-6 gap-3" id="avatar-presets">
            <!-- Preset Google (se disponibile) -->
            <button type="button" data-avatar-type="google" class="avatar-option relative group aspect-square rounded-2xl overflow-hidden border-2 border-slate-200 dark:border-slate-700 hover:border-cigno-blue transition-all bg-slate-100 dark:bg-slate-800 flex items-center justify-center" title="Foto Google">
              <img id="preset-google-img" src="" alt="Google" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-cigno-blue/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-bold">Google</div>
            </button>
            <!-- Preset 1 -->
            <button type="button" data-url="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=150&auto=format&fit=crop&q=80" class="avatar-option relative group aspect-square rounded-2xl overflow-hidden border-2 border-slate-200 dark:border-slate-700 hover:border-cigno-blue transition-all bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-xs">
              <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=150&auto=format&fit=crop&q=80" alt="Cyber" class="w-full h-full object-cover" />
            </button>
            <!-- Preset 2 -->
            <button type="button" data-url="https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?w=150&auto=format&fit=crop&q=80" class="avatar-option relative group aspect-square rounded-2xl overflow-hidden border-2 border-slate-200 dark:border-slate-700 hover:border-cigno-blue transition-all bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center text-white font-bold text-xs">
              <img src="https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?w=150&auto=format&fit=crop&q=80" alt="Abstract" class="w-full h-full object-cover" />
            </button>
            <!-- Preset 3 -->
            <button type="button" data-url="https://images.unsplash.com/photo-1579783902614-a3fb3927b675?w=150&auto=format&fit=crop&q=80" class="avatar-option relative group aspect-square rounded-2xl overflow-hidden border-2 border-slate-200 dark:border-slate-700 hover:border-cigno-blue transition-all bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white font-bold text-xs">
              <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b675?w=150&auto=format&fit=crop&q=80" alt="Art" class="w-full h-full object-cover" />
            </button>
            <!-- Preset 4 -->
            <button type="button" data-url="https://images.unsplash.com/photo-1614680376593-902f749f7ffc?w=150&auto=format&fit=crop&q=80" class="avatar-option relative group aspect-square rounded-2xl overflow-hidden border-2 border-slate-200 dark:border-slate-700 hover:border-cigno-blue transition-all bg-gradient-to-br from-purple-600 to-pink-600 flex items-center justify-center text-white font-bold text-xs">
              <img src="https://images.unsplash.com/photo-1614680376593-902f749f7ffc?w=150&auto=format&fit=crop&q=80" alt="Neon" class="w-full h-full object-cover" />
            </button>
            <!-- Preset 5 -->
            <button type="button" data-url="" class="avatar-option relative group aspect-square rounded-2xl overflow-hidden border-2 border-slate-200 dark:border-slate-700 hover:border-cigno-blue transition-all bg-gradient-to-br from-slate-700 to-slate-900 flex items-center justify-center text-white font-bold text-sm" title="Iniziali">
              <span>ABC</span>
            </button>
          </div>
        </div>

        <!-- Opzione URL personalizzato (Collapsible o discreta) -->
        <details class="group pt-2">
          <summary class="text-xs font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-cigno-blue transition-colors">Inserisci URL immagine personalizzato...</summary>
          <div class="mt-3">
            <input type="url" id="avatar-url-input" placeholder="https://esempio.com/avatar.jpg" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cigno-blue transition-all" />
          </div>
        </details>

        <div class="flex flex-col sm:flex-row gap-3 pt-4">
          <button id="save-profile-btn" class="flex-1 bg-cigno-blue text-white py-3 rounded-2xl font-semibold text-sm hover:opacity-90 transition-all shadow-lg shadow-cigno-blue/20">
            Salva Modifiche
          </button>
          <button id="logout-btn" class="px-6 bg-red-500/10 text-red-500 py-3 rounded-2xl font-semibold text-sm hover:bg-red-500/20 transition-all">
            Esci (Logout)
          </button>
        </div>
      </div>

      <div id="profile-message" class="mt-6 text-center text-xs font-medium"></div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    const displayName = document.getElementById('user-display-name');
    const displayEmail = document.getElementById('user-email');
    const nicknameInput = document.getElementById('nickname-input') as HTMLInputElement;
    const avatarUrlInput = document.getElementById('avatar-url-input') as HTMLInputElement;
    const avatarInitial = document.getElementById('avatar-initial');
    const avatarImg = document.getElementById('avatar-img') as HTMLImageElement;
    const presetGoogleImg = document.getElementById('preset-google-img') as HTMLImageElement;
    const saveBtn = document.getElementById('save-profile-btn');
    const logoutBtn = document.getElementById('logout-btn');
    const msg = document.getElementById('profile-message');
    const badgeHouse = document.getElementById('badge-house');
    const badgeClan = document.getElementById('badge-clan');
    const avatarOptions = document.querySelectorAll('.avatar-option');

    let currentUser: any = null;
    let selectedAvatarUrl = '';

    async function loadUser() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/accedi';
        return;
      }
      currentUser = session.user;
      const email = currentUser.email;
      displayEmail.textContent = email;

      const googleAvatar = currentUser.user_metadata?.avatar_url || '';
      if (googleAvatar) {
        presetGoogleImg.src = googleAvatar;
      } else {
        presetGoogleImg.parentElement?.classList.add('hidden');
      }

      const savedNick = localStorage.getItem('cigno_username') || currentUser.user_metadata?.full_name || email.split('@')[0];
      const savedAvatar = localStorage.getItem('cigno_avatar') || googleAvatar;
      const savedHouse = localStorage.getItem('cigno_house');
      const savedClan = localStorage.getItem('cigno_clan');

      nicknameInput.value = savedNick;
      if (savedAvatar) {
        avatarUrlInput.value = savedAvatar;
        selectedAvatarUrl = savedAvatar;
        setAvatar(savedAvatar, savedNick);
      } else {
        setAvatar('', savedNick);
      }

      displayName.textContent = savedNick;

      if (savedHouse) badgeHouse.textContent = `Casata: ${savedHouse}`;
      if (savedClan) badgeClan.textContent = `Clan: ${savedClan}`;
    }

    function setAvatar(url: string, name: string) {
      selectedAvatarUrl = url;
      if (url) {
        avatarImg.src = url;
        avatarImg.classList.remove('hidden');
        avatarInitial.classList.add('hidden');
      } else {
        avatarImg.classList.add('hidden');
        avatarInitial.classList.remove('hidden');
        avatarInitial.textContent = name ? name.charAt(0).toUpperCase() : '?';
      }

      // Highlight active option
      avatarOptions.forEach(opt => {
        const btnUrl = opt.getAttribute('data-url');
        const isGoogle = opt.getAttribute('data-avatar-type') === 'google';
        if ((isGoogle && url === currentUser?.user_metadata?.avatar_url) || (btnUrl !== null && btnUrl === url) || (!url && btnUrl === '')) {
          opt.classList.add('border-cigno-blue', 'ring-2', 'ring-cigno-blue/40');
        } else {
          opt.classList.remove('border-cigno-blue', 'ring-2', 'ring-cigno-blue/40');
        }
      });
    }

    avatarOptions.forEach(opt => {
      opt.addEventListener('click', () => {
        const isGoogle = opt.getAttribute('data-avatar-type') === 'google';
        const url = isGoogle ? (currentUser?.user_metadata?.avatar_url || '') : (opt.getAttribute('data-url') || '');
        avatarUrlInput.value = url;
        setAvatar(url, nicknameInput.value);
      });
    });

    avatarUrlInput?.addEventListener('input', () => {
      setAvatar(avatarUrlInput.value.trim(), nicknameInput.value);
    });

    saveBtn?.addEventListener('click', () => {
      const nick = nicknameInput.value.trim();
      const avatarUrl = avatarUrlInput.value.trim();

      if (nick) {
        localStorage.setItem('cigno_username', nick);
        displayName.textContent = nick;
      }

      localStorage.setItem('cigno_avatar', avatarUrl);
      setAvatar(avatarUrl, nick);

      if (msg) {
        msg.textContent = 'Profilo aggiornato con successo!';
        msg.className = 'mt-6 text-center text-xs font-medium text-emerald-500';
      }
    });

    logoutBtn?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    });

    loadUser();
  </script>
</Layout>
