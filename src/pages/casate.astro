---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Casate & Clan — Cignoverse">
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 bg-cigno-blue/10 text-cigno-blue dark:bg-cigno-blue/20 dark:text-blue-400 px-3 py-1 rounded-full text-xs font-semibold mb-4">
        <span>Smistamento Cignoverse & Gilde</span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">Le Casate & I Clan del Cigno</h1>
      <p class="text-lg text-slate-600 dark:text-slate-300">
        Scopri la tua vera natura digitale. Fai il test di smistamento interattivo, unisciti a una Casata, fonda il tuo Clan e partecipa alle guerre di gilda.
      </p>
    </div>

    <!-- Sezione Test / Profilo Utente -->
    <div id="smistamento-section" class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
      <!-- Card Test Smistamento -->
      <div class="lg:col-span-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-cigno-blue/10 rounded-full blur-2xl pointer-events-none"></div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Il Test di Smistamento</h2>
        <p class="text-slate-600 dark:text-slate-300 text-sm mb-6">
          Rispondi a 3 domande fondamentali sulla tua filosofia di sviluppo e scopri a quale Casata appartieni (Algoritmo, Sintassi, Bughunter o OpenSource).
        </p>

        <!-- Quiz Container -->
        <div id="quiz-container">
          <div id="quiz-intro">
            <button id="start-quiz-btn" class="bg-cigno-blue text-white px-6 py-3 rounded-xl font-semibold hover:opacity-90 transition-all shadow-lg shadow-cigno-blue/20">
              Inizia il Test di Smistamento
            </button>
          </div>

          <div id="quiz-questions" class="hidden space-y-6">
            <div class="flex justify-between text-xs font-semibold text-slate-400 uppercase tracking-wider">
              <span id="question-counter">Domanda 1 di 3</span>
              <span id="quiz-progress-text">33%</span>
            </div>
            <h3 id="question-title" class="text-xl font-semibold text-slate-900 dark:text-white"></h3>
            <div id="question-options" class="grid grid-cols-1 gap-3"></div>
          </div>

          <div id="quiz-result" class="hidden text-center py-8">
            <span class="text-xs font-semibold uppercase tracking-wider text-cigno-blue">Casata Assegnata</span>
            <h3 id="result-house-name" class="text-3xl font-extrabold text-slate-900 dark:text-white mt-2 mb-3"></h3>
            <p id="result-house-desc" class="text-slate-600 dark:text-slate-300 max-w-lg mx-auto mb-6 text-sm"></p>
            <div class="flex justify-center gap-4">
              <button id="save-house-btn" class="bg-cigno-blue text-white px-6 py-3 rounded-xl font-semibold hover:opacity-90 transition-all shadow-lg shadow-cigno-blue/20">
                Registra la tua Casata
              </button>
              <button id="retake-btn" class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-4 py-3 rounded-xl font-medium hover:bg-slate-200 dark:hover:bg-slate-700">
                Ricomincia Test
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Profilo & Casata Corrente -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Il tuo Profilo Cigno</h3>
          <div id="user-profile-card" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 mb-6">
            <div class="flex items-center gap-3 mb-3">
              <div id="user-avatar" class="w-10 h-10 rounded-full bg-cigno-blue/20 text-cigno-blue flex items-center justify-center font-bold">?</div>
              <div>
                <p id="user-name-display" class="font-bold text-slate-900 dark:text-white text-sm">Ospite</p>
                <p id="user-house-display" class="text-xs text-slate-500 dark:text-slate-400">Nessuna Casata</p>
              </div>
            </div>
            <div id="user-clan-info" class="text-xs text-slate-600 dark:text-slate-300">
              Clan: <span class="font-semibold text-slate-900 dark:text-white">Nessuno</span>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <label for="username-input" class="block text-xs font-medium text-slate-700 dark:text-slate-300">Il tuo Nickname:</label>
          <input type="text" id="username-input" placeholder="Es. CignuxCoder" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cigno-blue" />
          <button id="update-profile-btn" class="w-full bg-slate-800 dark:bg-slate-700 text-white py-2 rounded-lg font-medium text-sm hover:opacity-90 transition-opacity">
            Aggiorna Profilo
          </button>
        </div>
      </div>
    </div>

    <!-- Sezione Clan & Guerre tra Clan -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
      <!-- Clan attivi -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Gilde & Clan</h2>
          <button id="open-create-clan-modal" class="text-xs bg-cigno-blue/10 text-cigno-blue dark:bg-cigno-blue/20 dark:text-blue-400 px-3 py-1.5 rounded-lg font-semibold hover:bg-cigno-blue/20">
            Crea Clan
          </button>
        </div>
        <div id="clans-list" class="space-y-4">
          <!-- Popolato via JS -->
        </div>
      </div>

      <!-- Guerre tra Clan (Leaderboard & War status) -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Guerre tra Clan</h2>
        <p class="text-slate-600 dark:text-slate-300 text-sm mb-6">
          La battaglia settimanale per il dominio del Cignoverse. Guadagna punti contribuendo ai 5 progetti e portando alla vittoria il tuo clan.
        </p>

        <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 mb-6">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Guerra in corso</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Termina tra 3 giorni</span>
          </div>
          <p class="text-sm font-semibold text-slate-900 dark:text-white">Scontro: Bugfix Titans vs OpenSource Legion</p>
        </div>

        <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-3">Classifica Clan</h3>
        <div id="clans-leaderboard" class="space-y-3">
          <!-- Popolato via JS -->
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Crea Clan -->
  <div id="clan-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 max-w-md w-full shadow-2xl">
      <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4">Fonda un nuovo Clan</h3>
      <div class="space-y-4">
        <div>
          <label for="new-clan-name" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Nome del Clan:</label>
          <input type="text" id="new-clan-name" placeholder="Es. CignoNerd Warriors" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm" />
        </div>
        <div>
          <label for="new-clan-tag" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Tag (es. [CNG]):</label>
          <input type="text" id="new-clan-tag" placeholder="[CNG]" maxlength="5" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm uppercase" />
        </div>
        <div class="flex justify-end gap-3 pt-2">
          <button id="close-modal-btn" class="px-4 py-2 rounded-lg text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">Annulla</button>
          <button id="submit-clan-btn" class="bg-cigno-blue text-white px-4 py-2 rounded-lg text-sm font-semibold hover:opacity-90">Crea</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const houses = [
      {
        id: 'algoritmo',
        name: 'Casata Algoritmo',
        color: 'text-blue-500',
        bg: 'bg-blue-500/10',
        desc: 'Dediti alla logica pura, all\'ottimizzazione estrema e alla risoluzione di problemi complessi senza scrivere una riga di codice ridondante.'
      },
      {
        id: 'sintassi',
        name: 'Casata Sintassi',
        color: 'text-emerald-500',
        bg: 'bg-emerald-500/10',
        desc: 'Amanti dell\'ordine, della pulizia del codice e della leggibilità impeccabile. Per loro ogni parentesi graffa ha un significato sacro.'
      },
      {
        id: 'bughunter',
        name: 'Casata Bughunter',
        color: 'text-amber-500',
        bg: 'bg-amber-500/10',
        desc: 'Cacciatori implacabili di bug e crash misteriosi. Non conoscono sosta finché l\'ultimo errore non è stato debellato dal sistema.'
      },
      {
        id: 'opensource',
        name: 'Casata OpenSource',
        color: 'text-purple-500',
        bg: 'bg-purple-500/10',
        desc: 'Campioni della condivisione e della collaborazione globale. Credono che il sapere debba essere libero e accessibile a chiunque.'
      }
    ];

    const questions = [
      {
        title: 'Qual è il tuo approccio quando incontri un bug critico?',
        options: [
          { text: 'Analizzo la complessità computazionale e studio la teoria.', house: 'algoritmo' },
          { text: 'Riscrivo il blocco indentandolo alla perfezione.', house: 'sintassi' },
          { text: 'Metto i log ovunque finché non scopro il colpevole.', house: 'bughunter' },
          { text: 'Chiedo aiuto alla community e apro una issue su GitHub.', house: 'opensource' }
        ]
      },
      {
        title: 'Quale strumento consideri il più sacro per uno sviluppatore?',
        options: [
          { text: 'L\'algoritmo di ordinamento perfetto.', house: 'algoritmo' },
          { text: 'Un linter inflessibile.', house: 'sintassi' },
          { text: 'Il debugger in tempo reale.', house: 'bughunter' },
          { text: 'Il tasto per la Pull Request.', house: 'opensource' }
        ]
      },
      {
        title: 'Come preferisci lavorare ai 5 progetti in corso?',
        options: [
          { text: 'Risolvendo i problemi logici più ostici.', house: 'algoritmo' },
          { text: 'Curando design system e formattazione.', house: 'sintassi' },
          { text: 'Testando ogni singolo caso limite.', house: 'bughunter' },
          { text: 'Collaborando con altri dev coordinando i task.', house: 'opensource' }
        ]
      }
    ];

    let currentQuizIndex = 0;
    let scores = { algoritmo: 0, sintassi: 0, bughunter: 0, opensource: 0 };
    let assignedHouse: any = null;
    let username = localStorage.getItem('cigno_username') || 'Cignoder';
    let userHouse = localStorage.getItem('cigno_house') || null;
    let userClan = localStorage.getItem('cigno_clan') || 'Nessuno';

    let clans = JSON.parse(localStorage.getItem('cigno_clans') || JSON.stringify([
      { id: 1, name: 'CyberCigni', tag: '[CYB]', points: 1420, members: 8 },
      { id: 2, name: 'NullPointers', tag: '[NULL]', points: 1150, members: 6 },
      { id: 3, name: 'Async Legion', tag: '[ASYNC]', points: 980, members: 5 }
    ]));

    const userNameDisplay = document.getElementById('user-name-display');
    const userHouseDisplay = document.getElementById('user-house-display');
    const userClanInfo = document.getElementById('user-clan-info');
    const usernameInput = document.getElementById('username-input') as HTMLInputElement;
    const updateProfileBtn = document.getElementById('update-profile-btn');
    
    const startQuizBtn = document.getElementById('start-quiz-btn');
    const quizIntro = document.getElementById('quiz-intro');
    const quizQuestions = document.getElementById('quiz-questions');
    const quizResult = document.getElementById('quiz-result');
    const questionTitle = document.getElementById('question-title');
    const questionCounter = document.getElementById('question-counter');
    const quizProgressText = document.getElementById('quiz-progress-text');
    const questionOptions = document.getElementById('question-options');
    const resultHouseName = document.getElementById('result-house-name');
    const resultHouseDesc = document.getElementById('result-house-desc');
    const saveHouseBtn = document.getElementById('save-house-btn');
    const retakeBtn = document.getElementById('retake-btn');

    const clansList = document.getElementById('clans-list');
    const clansLeaderboard = document.getElementById('clans-leaderboard');
    const openCreateClanModal = document.getElementById('open-create-clan-modal');
    const clanModal = document.getElementById('clan-modal');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const submitClanBtn = document.getElementById('submit-clan-btn');
    const newClanNameInput = document.getElementById('new-clan-name') as HTMLInputElement;
    const newClanTagInput = document.getElementById('new-clan-tag') as HTMLInputElement;
    const userAvatar = document.getElementById('user-avatar');

    function updateUI() {
      if (userNameDisplay) userNameDisplay.textContent = username;
      if (usernameInput) usernameInput.value = username;
      if (userAvatar) userAvatar.textContent = username.charAt(0).toUpperCase();

      if (userHouse) {
        const h = houses.find(item => item.id === userHouse);
        if (userHouseDisplay) {
          userHouseDisplay.textContent = h ? h.name : userHouse;
          userHouseDisplay.className = `text-xs font-semibold ${h ? h.color : 'text-slate-400'}`;
        }
      } else {
        if (userHouseDisplay) {
          userHouseDisplay.textContent = 'Nessuna Casata';
          userHouseDisplay.className = 'text-xs text-slate-400';
        }
      }

      if (userClanInfo) {
        userClanInfo.innerHTML = `Clan: <span class="font-semibold text-slate-900 dark:text-white">${userClan}</span>`;
      }

      renderClans();
    }

    function renderClans() {
      const sorted = [...clans].sort((a, b) => b.points - a.points);
      
      if (clansList) {
        clansList.innerHTML = clans.map(c => `
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-cigno-blue mr-2">${c.tag}</span>
              <span class="font-bold text-slate-900 dark:text-white">${c.name}</span>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">${c.members} membri • ${c.points} punti guerra</p>
            </div>
            <button onclick="window.joinClan('${c.name}')" class="text-xs px-3 py-1.5 rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 font-medium hover:bg-cigno-blue hover:text-white transition-colors">
              ${userClan === c.name ? 'Il tuo Clan' : 'Unisciti'}
            </button>
          </div>
        `).join('');
      }

      if (clansLeaderboard) {
        clansLeaderboard.innerHTML = sorted.map((c, index) => `
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/40">
            <div class="flex items-center gap-3">
              <span class="font-bold text-sm text-slate-400">#${index + 1}</span>
              <div>
                <span class="font-semibold text-slate-900 dark:text-white text-sm">${c.name}</span>
                <span class="text-xs text-slate-500 ml-1">${c.tag}</span>
              </div>
            </div>
            <span class="text-sm font-bold text-cigno-blue">${c.points} pt</span>
          </div>
        `).join('');
      }
    }

    (window as any).joinClan = function(name: string) {
      userClan = name;
      localStorage.setItem('cigno_clan', userClan);
      updateUI();
    };

    updateProfileBtn?.addEventListener('click', () => {
      if (usernameInput.value.trim()) {
        username = usernameInput.value.trim();
        localStorage.setItem('cigno_username', username);
        updateUI();
      }
    });

    startQuizBtn?.addEventListener('click', () => {
      quizIntro?.classList.add('hidden');
      quizQuestions?.classList.remove('hidden');
      currentQuizIndex = 0;
      scores = { algoritmo: 0, sintassi: 0, bughunter: 0, opensource: 0 };
      loadQuestion();
    });

    function loadQuestion() {
      const q = questions[currentQuizIndex];
      if (questionTitle) questionTitle.textContent = q.title;
      if (questionCounter) questionCounter.textContent = `Domanda ${currentQuizIndex + 1} di ${questions.length}`;
      if (quizProgressText) quizProgressText.textContent = `${Math.round(((currentQuizIndex + 1) / questions.length) * 100)}%`;

      if (questionOptions) {
        questionOptions.innerHTML = q.options.map((opt) => `
          <button data-house="${opt.house}" class="quiz-option text-left p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-medium hover:border-cigno-blue hover:bg-cigno-blue/5 transition-all">
            ${opt.text}
          </button>
        `).join('');

        document.querySelectorAll('.quiz-option').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const house = (e.currentTarget as HTMLElement).getAttribute('data-house') as keyof typeof scores;
            scores[house]++;
            currentQuizIndex++;
            if (currentQuizIndex < questions.length) {
              loadQuestion();
            } else {
              finishQuiz();
            }
          });
        });
      }
    }

    function finishQuiz() {
      quizQuestions?.classList.add('hidden');
      quizResult?.classList.remove('hidden');

      let bestHouse = 'algoritmo';
      let maxScore = -1;
      for (const h in scores) {
        if (scores[h as keyof typeof scores] > maxScore) {
          maxScore = scores[h as keyof typeof scores];
          bestHouse = h;
        }
      }

      assignedHouse = houses.find(h => h.id === bestHouse);
      if (resultHouseName) {
        resultHouseName.textContent = assignedHouse.name;
        resultHouseName.className = `text-3xl font-extrabold mt-2 mb-3 ${assignedHouse.color}`;
      }
      if (resultHouseDesc) {
        resultHouseDesc.textContent = assignedHouse.desc;
      }
    }

    saveHouseBtn?.addEventListener('click', () => {
      if (assignedHouse) {
        userHouse = assignedHouse.id;
        localStorage.setItem('cigno_house', userHouse);
        updateUI();
        quizResult?.classList.add('hidden');
        quizIntro?.classList.remove('hidden');
        alert(`Complimenti. Sei stato smistato nella ${assignedHouse.name}.`);
      }
    });

    retakeBtn?.addEventListener('click', () => {
      quizResult?.classList.add('hidden');
      quizIntro?.classList.remove('hidden');
    });

    openCreateClanModal?.addEventListener('click', () => {
      clanModal?.classList.remove('hidden');
    });
    closeModalBtn?.addEventListener('click', () => {
      clanModal?.classList.add('hidden');
    });
    submitClanBtn?.addEventListener('click', () => {
      const name = newClanNameInput.value.trim();
      const tag = newClanTagInput.value.trim().toUpperCase();
      if (name && tag) {
        clans.push({ id: Date.now(), name, tag, points: 100, members: 1 });
        localStorage.setItem('cigno_clans', JSON.stringify(clans));
        userClan = name;
        localStorage.setItem('cigno_clan', userClan);
        newClanNameInput.value = '';
        newClanTagInput.value = '';
        clanModal?.classList.add('hidden');
        updateUI();
      }
    });

    updateUI();
  </script>
</Layout>
