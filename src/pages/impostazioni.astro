---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impostazioni Account — Cignoverse">
  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-xl mx-auto">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 sm:p-10 shadow-sm">
      <div class="mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
        <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">Impostazioni Account</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Gestisci la sicurezza e le credenziali del tuo account.</p>
      </div>

      <div class="space-y-8">
        <!-- Cambio Email -->
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Cambia Indirizzo Email</h2>
          <div>
            <label for="new-email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Nuova Email</label>
            <input type="email" id="new-email" placeholder="nuova@email.com" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cigno-blue transition-all" />
          </div>
          <button id="update-email-btn" class="bg-cigno-blue text-white px-5 py-2.5 rounded-xl font-semibold text-sm hover:opacity-90 transition-all shadow-md shadow-cigno-blue/20">
            Aggiorna Email
          </button>
        </div>

        <hr class="border-slate-200 dark:border-slate-800" />

        <!-- Cambio Password -->
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Modifica Password</h2>
          <div>
            <label for="new-password" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Nuova Password</label>
            <input type="password" id="new-password" placeholder="••••••••" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cigno-blue transition-all" />
          </div>
          <button id="update-password-btn" class="bg-cigno-blue text-white px-5 py-2.5 rounded-xl font-semibold text-sm hover:opacity-90 transition-all shadow-md shadow-cigno-blue/20">
            Aggiorna Password
          </button>
        </div>
      </div>

      <div id="settings-message" class="mt-6 text-center text-xs font-medium"></div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    const newEmailInput = document.getElementById('new-email') as HTMLInputElement;
    const updateEmailBtn = document.getElementById('update-email-btn');
    const newPasswordInput = document.getElementById('new-password') as HTMLInputElement;
    const updatePasswordBtn = document.getElementById('update-password-btn');
    const msg = document.getElementById('settings-message');

    async function checkAuth() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/accedi';
      }
    }
    checkAuth();

    updateEmailBtn?.addEventListener('click', async () => {
      const email = newEmailInput.value.trim();
      if (!email) return;

      const { error } = await supabase.auth.updateUser({ email });
      if (error) {
        showMsg(error.message, true);
      } else {
        showMsg('Email aggiornata con successo! Controlla la casella di posta per la conferma.', false);
        newEmailInput.value = '';
      }
    });

    updatePasswordBtn?.addEventListener('click', async () => {
      const password = newPasswordInput.value.trim();
      if (!password) return;

      const { error } = await supabase.auth.updateUser({ password });
      if (error) {
        showMsg(error.message, true);
      } else {
        showMsg('Password aggiornata con successo!', false);
        newPasswordInput.value = '';
      }
    });

    function showMsg(text: string, isError: boolean) {
      if (msg) {
        msg.textContent = text;
        msg.className = `mt-6 text-center text-xs font-medium ${isError ? 'text-red-500' : 'text-emerald-500'}`;
      }
    }
  </script>
</Layout>
