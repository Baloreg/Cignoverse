---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina non trovata — Cignoverse">
  <div class="py-24 px-4 sm:px-6 lg:px-8 max-w-2xl mx-auto text-center">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-10 shadow-sm">
      <p class="text-6xl font-extrabold tracking-tight text-cigno-blue">404</p>
      <h1 class="mt-4 text-2xl font-extrabold text-slate-900 dark:text-white">Pagina non trovata</h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400">
        La pagina che stai cercando non esiste o è stata spostata. Verifica il link o torna alla homepage.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a href="/" class="bg-cigno-blue text-white px-5 py-2.5 rounded-xl font-semibold text-sm hover:opacity-90 transition-opacity">
          Torna alla home
        </a>
        <a href="/documentazione" class="bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 px-5 py-2.5 rounded-xl font-semibold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
          Documentazione
        </a>
      </div>
    </div>
  </div>
</Layout>
