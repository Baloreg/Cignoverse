---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Wiki Ufficiale della Lore — Le Cinque Corone del Cigno">
    <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-12 border-b border-slate-200 dark:border-slate-800 pb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
                <div class="inline-flex items-center gap-2 bg-cigno-blue/10 text-cigno-blue dark:bg-cigno-blue/20 dark:text-blue-400 px-3 py-1 rounded-full text-xs font-semibold mb-3">
                    <span>
                        Enciclopedia della Lore • Costellazione del Cigno
                        (Cygnus)
                    </span>
                </div>
                <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                    Wiki della Lore: Le Cinque Corone
                </h1>
                <p class="mt-2 text-lg text-slate-600 dark:text-slate-300 max-w-2xl">
                    L'archivio storico, mitologico e geopolitico definitivo del
                    mondo di Deneb, della Frattura e delle grandi casate
                    nobiliari.
                </p>
            </div>
            <div class="w-full md:w-80">
                <div class="relative">
                    <input
                        type="text"
                        id="wiki-search"
                        placeholder="Cerca nei registri della Lore..."
                        class="w-full px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cigno-blue"
                    />
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            <!-- Sidebar Indice Lore -->
            <aside class="space-y-6">
                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                        Indice della Lore
                    </h3>
                    <nav class="space-y-1 text-sm font-medium">
                        <button
                            data-target="lore-identita"
                            class="wiki-nav-btn w-full text-left px-3 py-2 rounded-lg bg-cigno-blue/10 text-cigno-blue font-semibold transition-colors flex items-center gap-2"
                        >
                            <span>🌌</span> 1. Identità del Mondo
                        </button>
                        <button
                            data-target="lore-regola"
                            class="wiki-nav-btn w-full text-left px-3 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center gap-2"
                        >
                            <span>⚖️</span> 2. Tono & Regola d'Oro
                        </button>
                        <button
                            data-target="lore-stellare"
                            class="wiki-nav-btn w-full text-left px-3 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center gap-2"
                        >
                            <span>✨</span> 3. Sistema Stellare & Deneb
                        </button>
                        <button
                            data-target="lore-corone"
                            class="wiki-nav-btn w-full text-left px-3 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center gap-2"
                        >
                            <span>👑</span> 4. Le Cinque Corone
                        </button>
                        <button
                            data-target="lore-veyr-veth"
                            class="wiki-nav-btn w-full text-left px-3 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center gap-2"
                        >
                            <span>⚡</span> 5. Energia Veyr & Rete Veth
                        </button>
                        <button
                            data-target="lore-cronologia"
                            class="wiki-nav-btn w-full text-left px-3 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center gap-2"
                        >
                            <span>📜</span> 6. Cronologia & La Frattura
                        </button>
                    </nav>
                </div>
            </aside>

            <!-- Contenuti Wiki Lore -->
            <main class="lg:col-span-3 space-y-8">
                <!-- 1. Identità -->
                <section
                    id="lore-identita"
                    class="wiki-section bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm space-y-6"
                >
                    <div class="flex items-center gap-3 text-cigno-blue mb-2">
                        <span class="text-2xl">🌌</span>
                        <span class="text-xs font-bold uppercase tracking-wider">
                            Capitolo 01
                        </span>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
                        Identità del Mondo
                    </h2>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-600 dark:text-slate-300 border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold">
                                    <th class="py-3 px-4">Elemento</th>
                                    <th class="py-3 px-4">Designazione</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50">
                                <tr>
                                    <td class="py-3 px-4 font-medium text-slate-900 dark:text-white">
                                        Setting
                                    </td>
                                    <td class="py-3 px-4">
                                        Le Cinque Corone del Cigno
                                    </td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-4 font-medium text-slate-900 dark:text-white">
                                        Settore Galattico
                                    </td>
                                    <td class="py-3 px-4">
                                        Costellazione del Cigno (Cygnus)
                                    </td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-4 font-medium text-slate-900 dark:text-white">
                                        Stella Dominante
                                    </td>
                                    <td class="py-3 px-4">
                                        Deneb ($\alpha$ Cygni)
                                    </td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-4 font-medium text-slate-900 dark:text-white">
                                        Antico Impero
                                    </td>
                                    <td class="py-3 px-4">Impero Cygnico</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-4 font-medium text-slate-900 dark:text-white">
                                        Evento di Crollo
                                    </td>
                                    <td class="py-3 px-4">
                                        La Frattura (700 anni fa)
                                    </td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-4 font-medium text-slate-900 dark:text-white">
                                        Lingua Antica
                                    </td>
                                    <td class="py-3 px-4">Cygnico antico</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-4 font-medium text-slate-900 dark:text-white">
                                        Energia / Magia
                                    </td>
                                    <td class="py-3 px-4">Veyr</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-4 font-medium text-slate-900 dark:text-white">
                                        Trono Orbitale Conteso
                                    </td>
                                    <td class="py-3 px-4">La Croce del Nord</td>
                                </tr>
                                <tr>
                                    <td class="py-3 px-4 font-medium text-slate-900 dark:text-white">
                                        Rete di Portali
                                    </td>
                                    <td class="py-3 px-4">Veth</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- 2. Tono & Regola d'Oro -->
                <section
                    id="lore-regola"
                    class="wiki-section hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm space-y-4"
                >
                    <div class="flex items-center gap-3 text-amber-500 mb-2">
                        <span class="text-2xl">⚖️</span>
                        <span class="text-xs font-bold uppercase tracking-wider">
                            Capitolo 02
                        </span>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
                        Tono e Regola d'Oro
                    </h2>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed font-semibold">
                        Tono: Realismo dinastico con reliquie stellari.
                    </p>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
                        Il feudalesimo non è una scelta estetica, ma una{" "}
                        <strong>soluzione logistica</strong> a un problema di
                        comunicazione interstellare. La Rete Veth è instabile: i
                        portali funzionano, ma in modo imprevedibile. Il potere
                        centrale non può esistere. Le casate sono entità
                        economiche e militari che controllano nodi Veyr, rotte e
                        risorse vitali.
                    </p>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
                        Il <strong>Veyr</strong> non è magia fantasy. È una
                        forza fisica incanalata attraverso infrastrutture:
                        portali, motori, sistemi di comunicazione. Chi controlla
                        i nodi Veyr controlla il commercio e la sopravvivenza.
                    </p>
                </section>

                <!-- 3. Sistema Stellare -->
                <section
                    id="lore-stellare"
                    class="wiki-section hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm space-y-4"
                >
                    <div class="flex items-center gap-3 text-purple-500 mb-2">
                        <span class="text-2xl">✨</span>
                        <span class="text-xs font-bold uppercase tracking-wider">
                            Capitolo 03
                        </span>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
                        Il Sistema Stellare: La Costellazione
                    </h2>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
                        La Costellazione del Cigno ospita sistemi orbitali unici
                        dominati dalla supergigante Deneb. Intorno ad essa
                        ruotano i resti della civiltà imperiale:
                    </p>
                    <ul class="list-disc pl-5 space-y-2 text-slate-600 dark:text-slate-300 text-sm">
                        <li>
                            <strong>Deneb Prime:</strong> Il nucleo centrale e
                            sede dei templi della conoscenza imperiale.
                        </li>
                        <li>
                            <strong>I Settori Periferici:</strong> Colonie
                            minerarie e stazioni energetiche collegate dai
                            instabili portali Veth.
                        </li>
                        <li>
                            <strong>La Croce del Nord:</strong> La struttura
                            orbitale monumentale contesa da tutte le casate per
                            legittimare il trono.
                        </li>
                    </ul>
                </section>

                <!-- 4. Le Cinque Corone -->
                <section
                    id="lore-corone"
                    class="wiki-section hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm space-y-4"
                >
                    <div class="flex items-center gap-3 text-blue-500 mb-2">
                        <span class="text-2xl">👑</span>
                        <span class="text-xs font-bold uppercase tracking-wider">
                            Capitolo 04
                        </span>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
                        Le Casate e le Corone
                    </h2>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
                        Le potenze nobiliari che reggono l'equilibrio precario
                        del Cignoverse:
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
                            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-1 text-amber-500">
                                Casata Veyr
                            </h3>
                            <p class="text-xs text-slate-600 dark:text-slate-300">
                                Monopolio energetico e gestione dei reattori
                                stellari.
                            </p>
                        </div>
                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
                            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-1 text-blue-500">
                                Casata Veth
                            </h3>
                            <p class="text-xs text-slate-600 dark:text-slate-300">
                                Controllo delle rotte di navigazione e dei
                                portali quantistici.
                            </p>
                        </div>
                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
                            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-1 text-purple-500">
                                Casata Deneb
                            </h3>
                            <p class="text-xs text-slate-600 dark:text-slate-300">
                                Discendenti diretti della dinastia imperiale
                                originaria.
                            </p>
                        </div>
                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
                            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-1 text-emerald-500">
                                I Liberi della Frattura
                            </h3>
                            <p class="text-xs text-slate-600 dark:text-slate-300">
                                Ribelli e hacker che operano al di fuori del
                                sistema feudale.
                            </p>
                        </div>
                    </div>
                </section>

                <!-- 5. Veyr & Veth -->
                <section
                    id="lore-veyr-veth"
                    class="wiki-section hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm space-y-4"
                >
                    <div class="flex items-center gap-3 text-emerald-500 mb-2">
                        <span class="text-2xl">⚡</span>
                        <span class="text-xs font-bold uppercase tracking-wider">
                            Capitolo 05
                        </span>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
                        Energia Veyr & Rete di Portali Veth
                    </h2>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
                        Il Veyr alimenta ogni tecnologia superstite. Senza di
                        esso, le città orbitali cadono nell'oscurità. La Rete
                        Veth, pur essendo instabile, è l'unica via per coprire
                        distanze galattiche in tempi accettabili, rendendo i
                        tecnici e gli ingegneri figure di immenso potere
                        politico.
                    </p>
                </section>

                <!-- 6. Cronologia -->
                <section
                    id="lore-cronologia"
                    class="wiki-section hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm space-y-4"
                >
                    <div class="flex items-center gap-3 text-amber-500 mb-2">
                        <span class="text-2xl">📜</span>
                        <span class="text-xs font-bold uppercase tracking-wider">
                            Capitolo 06
                        </span>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
                        Cronologia & La Frattura
                    </h2>
                    <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
                        Timeline degli eventi chiave che hanno plasmato il
                        Cignoverse: dall'apogeo dell'Impero Cygnico fino al
                        cataclisma della Frattura e all'attuale era delle Cinque
                        Corone.
                    </p>
                </section>
            </main>
        </div>
    </div>

    <script>
        const navBtns = document.querySelectorAll(".wiki-nav-btn");
        const sections = document.querySelectorAll(".wiki-section");
        const wikiSearch = document.getElementById(
            "wiki-search",
        ) as HTMLInputElement;

        navBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetId = btn.getAttribute("data-target");

                navBtns.forEach((b) => {
                    b.classList.remove(
                        "bg-cigno-blue/10",
                        "text-cigno-blue",
                        "font-semibold",
                    );
                    b.classList.add("text-slate-600", "dark:text-slate-400");
                });
                btn.classList.add(
                    "bg-cigno-blue/10",
                    "text-cigno-blue",
                    "font-semibold",
                );
                btn.classList.remove("text-slate-600", "dark:text-slate-400");

                sections.forEach((s) => {
                    if (s.id === targetId) {
                        s.classList.remove("hidden");
                    } else {
                        s.classList.add("hidden");
                    }
                });
            });
        });

        wikiSearch?.addEventListener("input", (e) => {
            const query = (e.target as HTMLInputElement).value.toLowerCase();
            sections.forEach((s) => {
                const text = s.textContent?.toLowerCase() || "";
                if (text.includes(query)) {
                    s.classList.remove("hidden");
                } else {
                    s.classList.add("hidden");
                }
            });
        });
    </script>
</Layout>
