---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Accedi / Registrati — Cignoverse">
    <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-md mx-auto">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-8 shadow-sm">
            <div class="text-center mb-8">
                <div class="inline-flex items-center gap-2 bg-cigno-blue/10 text-cigno-blue dark:bg-cigno-blue/20 dark:text-blue-400 px-3 py-1 rounded-full text-xs font-semibold mb-3">
                    <span>Autenticazione Reale</span>
                </div>
                <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">
                    Accedi al Cignoverse
                </h1>
                <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">
                    Entra con Google o usa la tua email
                </p>
            </div>

            <!-- Google Login Button -->
            <button
                id="google-login-btn"
                class="w-full flex items-center justify-center gap-3 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white py-3 rounded-xl font-semibold text-sm hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-all shadow-sm mb-6"
            >
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path
                        fill="#4285F4"
                        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                    />
                    <path
                        fill="#34A853"
                        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                    />
                    <path
                        fill="#FBBC05"
                        d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                    />
                    <path
                        fill="#EA4335"
                        d="M12 5.38c1.62 0 3.06.56 4.21,1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                    />
                </svg>
                Continua con Google
            </button>

            <div class="relative flex py-2 items-center mb-6">
                <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
                <span class="flex-shrink mx-4 text-xs text-slate-400 uppercase">
                    oppure con email
                </span>
                <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
            </div>

            <!-- Email Form -->
            <form id="email-auth-form" class="space-y-4">
                <div>
                    <label
                        for="email"
                        class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"
                    >
                        Email
                    </label>
                    <input
                        type="email"
                        id="email"
                        required
                        placeholder="tu@email.com"
                        class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cigno-blue"
                    />
                </div>
                <div>
                    <label
                        for="password"
                        class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1"
                    >
                        Password
                    </label>
                    <input
                        type="password"
                        id="password"
                        required
                        placeholder="••••••••"
                        class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cigno-blue"
                    />
                </div>
                <div class="flex gap-3 pt-2">
                    <button
                        type="submit"
                        id="login-btn"
                        class="flex-1 bg-cigno-blue text-white py-2.5 rounded-xl font-semibold text-sm hover:opacity-90 transition-all shadow-lg shadow-cigno-blue/20"
                    >
                        Accedi
                    </button>
                    <button
                        type="button"
                        id="signup-btn"
                        class="flex-1 bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 py-2.5 rounded-xl font-semibold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-all"
                    >
                        Registrati
                    </button>
                </div>
            </form>

            <div
                id="auth-message"
                class="mt-4 text-center text-xs font-medium"
            ></div>
        </div>
    </div>

    <script>
        import { supabase } from "../lib/supabase";

        const googleBtn = document.getElementById("google-login-btn");
        const form = document.getElementById("email-auth-form");
        const emailInput = document.getElementById("email") as HTMLInputElement;
        const passwordInput = document.getElementById(
            "password",
        ) as HTMLInputElement;
        const loginBtn = document.getElementById("login-btn");
        const signupBtn = document.getElementById("signup-btn");
        const msg = document.getElementById("auth-message");

        googleBtn?.addEventListener("click", async () => {
            const { error } = await supabase.auth.signInWithOAuth({
                provider: "google",
                options: {
                    redirectTo: window.location.origin + "/smistamento",
                },
            });
            if (error && msg) {
                msg.textContent = error.message;
                msg.className =
                    "mt-4 text-center text-xs font-medium text-red-500";
            }
        });

        loginBtn?.addEventListener("click", async (e) => {
            e.preventDefault();
            const email = emailInput.value.trim();
            const password = passwordInput.value.trim();
            if (!email || !password) return;

            const { data, error } = await supabase.auth.signInWithPassword({
                email,
                password,
            });
            if (error) {
                if (msg) {
                    msg.textContent = error.message;
                    msg.className =
                        "mt-4 text-center text-xs font-medium text-red-500";
                }
            } else {
                window.location.href = "/profilo";
            }
        });

        signupBtn?.addEventListener("click", async (e) => {
            e.preventDefault();
            const email = emailInput.value.trim();
            const password = passwordInput.value.trim();
            if (!email || !password) return;

            const { data, error } = await supabase.auth.signUp({
                email,
                password,
            });
            if (error) {
                if (msg) {
                    msg.textContent = error.message;
                    msg.className =
                        "mt-4 text-center text-xs font-medium text-red-500";
                }
            } else {
                // Prova ad effettuare subito il login per procedere allo smistamento
                const { error: loginError } =
                    await supabase.auth.signInWithPassword({
                        email,
                        password,
                    });
                window.location.href = "/smistamento";
            }
        });
    </script>
</Layout>
